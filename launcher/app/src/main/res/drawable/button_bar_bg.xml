<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV-style button bar (this TV, Customize > Button bar > Pill): one frosted pill holding all top buttons,
     like the tvOS top-right capsule. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#1FFFFFFF" />
    <stroke android:width="1dp" android:color="#38FFFFFF" />
    <corners android:radius="200dp" />
</shape>
