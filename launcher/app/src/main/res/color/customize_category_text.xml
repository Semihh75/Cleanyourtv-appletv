<?xml version="1.0" encoding="utf-8"?>
<!-- Customize's category list (this TV): dark on the white focused row, white otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FF111111" />
    <item android:state_activated="true" android:color="#FFFFFFFF" />
    <item android:color="#B3FFFFFF" />
</selector>
