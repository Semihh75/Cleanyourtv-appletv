<?xml version="1.0" encoding="utf-8"?>
<!-- Customize's category list (this TV): white when focused, a faint glass fill on the category shown on the right
     while focus is in its settings, nothing otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#24FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
