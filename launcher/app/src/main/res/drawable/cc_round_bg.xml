<?xml version="1.0" encoding="utf-8"?>
<!-- A round Control Center button: frosted when idle, white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval"><solid android:color="#F5FFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#26FFFFFF" /></shape>
    </item>
</selector>
