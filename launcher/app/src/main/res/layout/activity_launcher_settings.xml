<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings in an Apple TV style (this TV), grouped like tvOS Settings: a category list on the left
     (Themes, Clock & Buttons, Now Playing, Apps & Dock, Motion, General) and only the chosen category's settings on
     the right, so nothing is a long scroll. LauncherSettingsActivity shows one section at a time. The control ids
     are unchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_screen_bg"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/categoryList"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.35"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="52dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="14dp"
            android:text="@string/customize"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:fontFamily="@font/inter_semibold" />

        <TextView
            android:id="@+id/catThemes"
            style="@style/CustomizeCategory"
            android:drawableStart="@drawable/ic_picture"
            android:text="@string/cat_themes" />
        <TextView
            android:id="@+id/catClock"
            style="@style/CustomizeCategory"
            android:drawableStart="@drawable/ic_tune"
            android:text="@string/cat_clock" />
        <TextView
            android:id="@+id/catNowPlaying"
            style="@style/CustomizeCategory"
            android:drawableStart="@drawable/ic_sound"
            android:text="@string/cat_now_playing" />
        <TextView
            android:id="@+id/catWidgets"
            style="@style/CustomizeCategory"
            android:drawableStart="@drawable/ic_w_cloud"
            android:text="@string/cat_widgets" />
        <TextView
            android:id="@+id/catApps"
            style="@style/CustomizeCategory"
            android:drawableStart="@drawable/ic_apps"
            android:text="@string/cat_apps" />
        <TextView
            android:id="@+id/catMotion"
            style="@style/CustomizeCategory"
            android:drawableStart="@drawable/ic_control"
            android:text="@string/cat_motion" />
        <TextView
            android:id="@+id/catDisplay"
            style="@style/CustomizeCategory"
            android:drawableStart="@drawable/ic_sun"
            android:text="@string/cat_display" />
        <TextView
            android:id="@+id/catGeneral"
            style="@style/CustomizeCategory"
            android:drawableStart="@drawable/ic_settings"
            android:text="@string/cat_general" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/sectionScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.65"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="80dp"
            android:paddingTop="56dp"
            android:paddingBottom="64dp">

            <LinearLayout
                android:id="@+id/secThemes"
                style="@style/CustomizeSection">

                <TextView style="@style/CustomizeTitle" android:text="@string/cat_themes" />
                <TextView style="@style/AppleHint" android:layout_marginTop="0dp" android:text="@string/themes_hint" />

                <HorizontalScrollView
                    android:id="@+id/themeScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/themeRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView android:id="@+id/wallpaperChoice" style="@style/AppleRow" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/secClock"
                style="@style/CustomizeSection">

                <TextView style="@style/CustomizeTitle" android:text="@string/cat_clock" />

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/clock_position_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/clockPos0" style="@style/AppleSegment" android:text="@string/clock_left" />
                        <TextView android:id="@+id/clockPos1" style="@style/AppleSegment" android:text="@string/clock_center" />
                        <TextView android:id="@+id/clockPos2" style="@style/AppleSegment" android:text="@string/pos_right" />
                        <TextView android:id="@+id/clockPos3" style="@style/AppleSegment" android:text="@string/pos_middle" />
                        <TextView android:id="@+id/clockPosCustom" style="@style/AppleSegment" android:text="@string/pos_custom" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/clock_style_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/styleWhite" style="@style/AppleSegment" android:text="@string/style_white" />
                        <TextView android:id="@+id/styleTransparent" style="@style/AppleSegment" android:text="@string/style_transparent" />
                        <TextView android:id="@+id/styleGlass" style="@style/AppleSegment" android:text="@string/style_glass" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/clock_size_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/sizeS" style="@style/AppleSegment" android:text="@string/size_s" />
                        <TextView android:id="@+id/sizeM" style="@style/AppleSegment" android:text="@string/size_m" />
                        <TextView android:id="@+id/sizeL" style="@style/AppleSegment" android:text="@string/size_l" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/date_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/dateShow" style="@style/AppleSegment" android:text="@string/date_show" />
                        <TextView android:id="@+id/dateHide" style="@style/AppleSegment" android:text="@string/date_hide" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/buttons_position_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/buttonsPos0" style="@style/AppleSegment" android:text="@string/clock_left" />
                        <TextView android:id="@+id/buttonsPos1" style="@style/AppleSegment" android:text="@string/clock_center" />
                        <TextView android:id="@+id/buttonsPos2" style="@style/AppleSegment" android:text="@string/pos_right" />
                        <TextView android:id="@+id/buttonsPosCustom" style="@style/AppleSegment" android:text="@string/pos_custom" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/bar_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/barSeparate" style="@style/AppleSegment" android:text="@string/bar_separate" />
                        <TextView android:id="@+id/barPill" style="@style/AppleSegment" android:text="@string/bar_pill" />
                        <TextView android:id="@+id/barPillTime" style="@style/AppleSegment" android:text="@string/bar_pill_time" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/clock_format_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/clockSystem" style="@style/AppleSegment" android:text="@string/clock_format_system" />
                        <TextView android:id="@+id/clock12" style="@style/AppleSegment" android:text="@string/clock_format_12" />
                        <TextView android:id="@+id/clock24" style="@style/AppleSegment" android:text="@string/clock_format_24" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/secNowPlaying"
                style="@style/CustomizeSection">

                <TextView style="@style/CustomizeTitle" android:text="@string/cat_now_playing" />

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/np_show_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/npShow" style="@style/AppleSegment" android:text="@string/date_show" />
                        <TextView android:id="@+id/npHide" style="@style/AppleSegment" android:text="@string/date_hide" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/np_position_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/npPos0" style="@style/AppleSegment" android:text="@string/clock_left" />
                        <TextView android:id="@+id/npPos1" style="@style/AppleSegment" android:text="@string/clock_center" />
                        <TextView android:id="@+id/npPos2" style="@style/AppleSegment" android:text="@string/pos_right" />
                        <TextView android:id="@+id/npPosCustom" style="@style/AppleSegment" android:text="@string/pos_custom" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/np_layout_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/npLayoutShelf" style="@style/AppleSegment" android:text="@string/layout_shelf" />
                        <TextView android:id="@+id/npLayoutCard" style="@style/AppleSegment" android:text="@string/layout_card" />
                        <TextView android:id="@+id/npLayoutCompact" style="@style/AppleSegment" android:text="@string/layout_compact" />
                        <TextView android:id="@+id/npLayoutTile" style="@style/AppleSegment" android:text="@string/layout_tile" />
                        <TextView android:id="@+id/npLayoutCover" style="@style/AppleSegment" android:text="@string/layout_cover" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/np_style_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/npGlass" style="@style/AppleSegment" android:text="@string/style_glass" />
                        <TextView android:id="@+id/npColor" style="@style/AppleSegment" android:text="@string/style_color" />
                        <TextView android:id="@+id/npSolid" style="@style/AppleSegment" android:text="@string/style_solid" />
                        <TextView android:id="@+id/npMinimal" style="@style/AppleSegment" android:text="@string/style_minimal" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/np_progress_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/npProgShow" style="@style/AppleSegment" android:text="@string/date_show" />
                        <TextView android:id="@+id/npProgHide" style="@style/AppleSegment" android:text="@string/date_hide" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/np_source_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/npSrcShow" style="@style/AppleSegment" android:text="@string/date_show" />
                        <TextView android:id="@+id/npSrcHide" style="@style/AppleSegment" android:text="@string/date_hide" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/np_size_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/npSizeS" style="@style/AppleSegment" android:text="@string/size_s" />
                        <TextView android:id="@+id/npSizeM" style="@style/AppleSegment" android:text="@string/size_m" />
                        <TextView android:id="@+id/npSizeL" style="@style/AppleSegment" android:text="@string/size_l" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/secApps"
                style="@style/CustomizeSection">

                <TextView style="@style/CustomizeTitle" android:text="@string/cat_apps" />

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/columns_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/columns4" style="@style/AppleSegment" android:text="4" />
                        <TextView android:id="@+id/columns5" style="@style/AppleSegment" android:text="5" />
                        <TextView android:id="@+id/columns6" style="@style/AppleSegment" android:text="6" />
                        <TextView android:id="@+id/columns7" style="@style/AppleSegment" android:text="7" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/rows_below_dock_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/rows0" style="@style/AppleSegment" android:text="0" />
                        <TextView android:id="@+id/rows1" style="@style/AppleSegment" android:text="1" />
                        <TextView android:id="@+id/rows2" style="@style/AppleSegment" android:text="2" />
                        <TextView android:id="@+id/rows3" style="@style/AppleSegment" android:text="3" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/dock_opacity_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/dock100" style="@style/AppleSegment" android:text="100%" />
                        <TextView android:id="@+id/dock70" style="@style/AppleSegment" android:text="70%" />
                        <TextView android:id="@+id/dock50" style="@style/AppleSegment" android:text="50%" />
                        <TextView android:id="@+id/dock30" style="@style/AppleSegment" android:text="30%" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/secWidgets"
                style="@style/CustomizeSection">

                <TextView style="@style/CustomizeTitle" android:text="@string/cat_widgets" />
                <TextView style="@style/AppleHint" android:layout_marginTop="0dp" android:text="@string/widgets_hint" />

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/widget_weather" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/wWeatherShow" style="@style/AppleSegment" android:text="@string/date_show" />
                        <TextView android:id="@+id/wWeatherHide" style="@style/AppleSegment" android:text="@string/date_hide" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/np_position_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/wWeatherPos0" style="@style/AppleSegment" android:text="@string/widget_pos_tl" />
                        <TextView android:id="@+id/wWeatherPos1" style="@style/AppleSegment" android:text="@string/widget_pos_tc" />
                        <TextView android:id="@+id/wWeatherPos2" style="@style/AppleSegment" android:text="@string/widget_pos_below" />
                        <TextView android:id="@+id/wWeatherPosCustom" style="@style/AppleSegment" android:text="@string/pos_custom" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/np_style_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/wWeatherClean" style="@style/AppleSegment" android:text="@string/widget_clean" />
                        <TextView android:id="@+id/wWeatherGlass" style="@style/AppleSegment" android:text="@string/style_glass" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/widget_date" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/wDateShow" style="@style/AppleSegment" android:text="@string/date_show" />
                        <TextView android:id="@+id/wDateHide" style="@style/AppleSegment" android:text="@string/date_hide" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/np_position_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/wDatePos0" style="@style/AppleSegment" android:text="@string/widget_pos_tl" />
                        <TextView android:id="@+id/wDatePos1" style="@style/AppleSegment" android:text="@string/widget_pos_tc" />
                        <TextView android:id="@+id/wDatePos2" style="@style/AppleSegment" android:text="@string/widget_pos_below" />
                        <TextView android:id="@+id/wDatePosCustom" style="@style/AppleSegment" android:text="@string/pos_custom" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/np_style_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/wDateClean" style="@style/AppleSegment" android:text="@string/widget_clean" />
                        <TextView android:id="@+id/wDateGlass" style="@style/AppleSegment" android:text="@string/style_glass" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/secMotion"
                style="@style/CustomizeSection">

                <TextView style="@style/CustomizeTitle" android:text="@string/cat_motion" />

                <TextView android:id="@+id/animationsChoice" style="@style/AppleRow" />
                <TextView android:id="@+id/advancedChoice" style="@style/AppleRow" />
                <TextView style="@style/AppleHint" android:text="@string/advanced_effects_warning" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/secDisplay"
                style="@style/CustomizeSection">

                <TextView style="@style/CustomizeTitle" android:text="@string/cat_display" />

                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/appearance_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/appDark" style="@style/AppleSegment" android:text="@string/appearance_dark" />
                        <TextView android:id="@+id/appLight" style="@style/AppleSegment" android:text="@string/appearance_light" />
                        <TextView android:id="@+id/appAuto" style="@style/AppleSegment" android:text="@string/appearance_auto" />
                    </LinearLayout>
                </LinearLayout>
                <TextView style="@style/AppleHint" android:text="@string/appearance_hint" />
                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/night_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/nightOff" style="@style/AppleSegment" android:text="@string/cc_off" />
                        <TextView android:id="@+id/nightOn" style="@style/AppleSegment" android:text="On" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/night_from_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/nightFrom21" style="@style/AppleSegment" android:text="21:00" />
                        <TextView android:id="@+id/nightFrom22" style="@style/AppleSegment" android:text="22:00" />
                        <TextView android:id="@+id/nightFrom23" style="@style/AppleSegment" android:text="23:00" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/night_until_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/nightUntil6" style="@style/AppleSegment" android:text="06:00" />
                        <TextView android:id="@+id/nightUntil7" style="@style/AppleSegment" android:text="07:00" />
                        <TextView android:id="@+id/nightUntil8" style="@style/AppleSegment" android:text="08:00" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/AppleCard">
                    <TextView style="@style/AppleLabel" android:text="@string/night_level_label" />
                    <LinearLayout style="@style/AppleTrack">
                        <TextView android:id="@+id/nightLevel20" style="@style/AppleSegment" android:text="20%" />
                        <TextView android:id="@+id/nightLevel30" style="@style/AppleSegment" android:text="30%" />
                        <TextView android:id="@+id/nightLevel40" style="@style/AppleSegment" android:text="40%" />
                        <TextView android:id="@+id/nightLevel50" style="@style/AppleSegment" android:text="50%" />
                    </LinearLayout>
                </LinearLayout>
                <TextView style="@style/AppleHint" android:text="@string/night_hint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/secGeneral"
                style="@style/CustomizeSection">

                <TextView style="@style/CustomizeTitle" android:text="@string/cat_general" />

                <TextView
                    android:id="@+id/reorderChoice"
                    style="@style/AppleRow"
                    android:text="@string/reorder"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/openOnStartChoice"
                    style="@style/AppleRow"
                    android:visibility="gone" />
                <TextView android:id="@+id/followThemeChoice" style="@style/AppleRow" android:text="@string/follow_theme" />
                <TextView style="@style/AppleHint" android:text="@string/follow_theme_hint" />
                <TextView android:id="@+id/defaultHomeChoice" style="@style/AppleRow" android:text="@string/home_settings" />
                <TextView style="@style/AppleHint" android:text="@string/home_settings_help" />
                <TextView android:id="@+id/tvSettingsChoice" style="@style/AppleRow" android:text="@string/tv_settings" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
