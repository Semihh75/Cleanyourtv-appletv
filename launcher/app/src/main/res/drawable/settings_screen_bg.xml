<?xml version="1.0" encoding="utf-8"?>
<!-- Deep graphite with a soft light from the top left, like Apple TV's settings. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0A0B0E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.22" android:centerY="0.35"
                android:gradientRadius="900dp" android:startColor="#FF262A33" android:endColor="#000A0B0E" />
        </shape>
    </item>
</layer-list>
