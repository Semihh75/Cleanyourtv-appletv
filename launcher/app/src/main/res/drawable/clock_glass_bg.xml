<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass panel behind the clock (clock style "Glass") and the placement hint: a frosted wash, brighter at
     the top, with a thin light rim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#14FFFFFF" />
    <stroke android:width="1.5dp" android:color="#4DFFFFFF" />
    <corners android:radius="30dp" />
</shape>
